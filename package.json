{
  "name": "the-curious-brief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma.js generate && next build",
    "start": "node scripts/prisma.js db push --skip-generate && next start -p ${PORT:-3000}",
    "lint": "next lint",
    "db:push": "node scripts/prisma.js db push",
    "db:studio": "node scripts/prisma.js studio",
    "ingest": "tsx scripts/ingest.ts",
    "postinstall": "node scripts/prisma.js generate",
    "ai:check": "tsx scripts/ai-check.ts",
    "ai:check:full": "tsx scripts/ai-check.ts --full",
    "start:windows": "node scripts/prisma.js db push --skip-generate && next start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@prisma/client": "^6.10.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.18.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^18.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.10.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}