# ── Database ──────────────────────────────────────────────────────────────
# Local development (default): SQLite file.
DATABASE_URL="file:./dev.db"
# Production (Supabase / Postgres): also change provider in prisma/schema.prisma to "postgresql".
# DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────
# Any long random string. Used to sign session cookies. REQUIRED in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# ── AI layer ──────────────────────────────────────────────────────────────
# Powers: AI quick reads, deep dives, Ask Curio, perspective review, AI-classified
# connections and the weekly digest synthesis. Configure ONE of the providers below.
# Without any key the app still runs with clearly-labelled source-grounded summaries.

# Option A — NVIDIA NIM (free developer tier, OpenAI-compatible). Key from https://build.nvidia.com
NVIDIA_API_KEY=""
NVIDIA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
# Verified on the free tier: nvidia/nemotron-3-ultra-550b-a55b (best), openai/gpt-oss-20b (slower). Check your enabled models at https://build.nvidia.com
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Option B — Anthropic (paid). https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Force a provider when both keys are set: "nvidia" | "anthropic" (default: Anthropic if set, else NVIDIA)
AI_PROVIDER=""

# ── Economic data (optional) ──────────────────────────────────────────────
# FRED (Federal Reserve Bank of St. Louis). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Enables: Fed funds rate, US CPI (monthly), US 10-year yield, Brent crude.
FRED_API_KEY=""

# ── Refresh schedule (minutes) ────────────────────────────────────────────
REFRESH_BREAKING_MINUTES=15
REFRESH_GENERAL_MINUTES=30
REFRESH_ANALYSIS_MINUTES=360
REFRESH_ECON_MINUTES=720
# Secret for the external cron endpoint (/api/cron/refresh?key=...). Optional locally.
CRON_SECRET=""
# Set to "false" to disable the in-process scheduler (on serverless, use an external cron instead).
IN_PROCESS_SCHEDULER="true"
